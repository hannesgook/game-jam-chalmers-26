# ---------------------------------------------------------------------------
# Unity 6 (6000.3.10f1) — GameJam-26
# ---------------------------------------------------------------------------

# Unity-generated folders (regenerated by the Editor on open)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ProfilerCaptures/

# Asset meta data — only ignore .meta files for assets that were deleted.
# (Never ignore .meta in general: Unity needs them tracked.)
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Package manager
/[Pp]ackages/*.tgz
# Keep manifest.json and packages-lock.json — they define the project.

# Autogenerated VS/Rider/VS Code project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig
/.idea/
/.vs/
/[Ee]xported[Oo]bj/
/*.[Cc]sproj.*
ExportedObj/
.consulo/

# VS Code — keep shared workspace config, drop machine-local state
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
!/.vscode/launch.json
!/.vscode/tasks.json

# Unity crash / build reports
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Addressables / Burst / build artifacts
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Ll]ibrary/com.unity.addressables/
*_BurstDebugInformation_DoNotShip*/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Builds and packaged output
/Builds/

# Local source elevation package (hundreds of MB). The reduced, game-ready
# Assets/Map_data/gothenburg_height_513.bytes remains tracked.
/Assets/Map_data/639_14/
/Assets/Map_data/639_14.meta
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dll.mdb
*.x86
*.x86_64

# Live Unity Editor lock/state files
/[Aa]ssets/**/*.unity.meta.tmp
*.stackdump

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini

# Secrets / local overrides
*.env
.env.local
/secrets/
